{
  "name": "@cleocode/worktree",
  "version": "2026.10.26",
  "private": false,
  "type": "module",
  "description": "Native CLEO worktree backend SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worktree-locate.js": {
      "types": "./dist/worktree-locate.d.ts",
      "import": "./dist/worktree-locate.js",
      "default": "./dist/worktree-locate.js"
    },
    "./native/*": "./native/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "native/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "cleo",
    "worktree",
    "git",
    "agent",
    "sdk",
    "isolation"
  ],
  "engines": {
    "node": ">=24.16.0"
  },
  "author": "CLEO Code <hello@cleocode.dev>",
  "license": "MIT",
  "dependencies": {
    "@cleocode/contracts": "workspace:*",
    "@cleocode/paths": "workspace:*"
  },
  "devDependencies": {
    "@cleocode/core": "workspace:*",
    "@types/node": "^24.3.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kryptobaseddev/cleo",
    "directory": "packages/worktree"
  }
}
