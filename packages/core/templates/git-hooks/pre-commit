#!/bin/sh
# CLEO_MANAGED_HOOK v1
# Pre-commit guardrails:
#   1. Reject SQLite WAL/SHM files (data corruption risk).
#   2. Block commits when core CLEO files are gitignored (data integrity).
#   3. Refuse CLEO runtime state staged at ANY path (T14189).
#   4. Refuse staged .cleo/ runtime paths: the shipped .cleo/.gitignore
#      EXPLICIT DENY rules (T14549).
#
# A pre-commit hook that was here before CLEO runs FIRST (T14549), so every
# check below sees the index that hook leaves behind.
#
# Only additions and modifications are checked: staging the deletion of a
# runtime file (`git rm --cached`, `cleo doctor --fix`) is the repair.
#
# Installation: Automatically installed via `cleo init`

set -e

# ── 0. A pre-commit hook that was here before CLEO (chained, T14549) ──
if [ -x "$0.cleo-chained" ]; then
  "$0.cleo-chained" "$@" || exit $?
fi

# ── 1. WAL/SHM/journal files ──────────────────────────────────────────
BAD_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(db-wal|db-shm|db-journal)$' || true)

if [ -n "$BAD_FILES" ]; then
  echo "ERROR: Refusing to commit SQLite WAL/SHM/journal files:"
  echo "$BAD_FILES"
  echo ""
  echo "These are runtime files that must never be tracked in git."
  echo "To fix: git rm --cached <file>"
  exit 1
fi

# ── 2. Core file gitignore protection ─────────────────────────────────
# Per ADR-013 §9 (T5158 — 2026-04-07): tasks.db, brain.db, config.json,
# and project-info.json are NOT tracked in git (regenerated by cleo init,
# backed up via VACUUM INTO snapshots). DO NOT include those four files
# in PROTECTED_FILES — that would re-open the T5158 data-loss vector.
PROTECTED_FILES=".cleo/.gitignore .cleo/project-context.json"
IGNORED_CORE=""

for f in $PROTECTED_FILES; do
  if [ -f "$f" ] && git check-ignore -q "$f" 2>/dev/null; then
    IGNORED_CORE="$IGNORED_CORE $f"
  fi
done

if [ -n "$IGNORED_CORE" ]; then
  echo "ERROR: Critical CLEO files are being ignored by .gitignore:"
  echo "$IGNORED_CORE"
  echo ""
  echo "These files MUST be tracked by git for CLEO data integrity."
  echo "Check .gitignore and .cleo/.gitignore for rules ignoring these files."
  echo "To fix: remove the ignore rule, then: git add <file>"
  exit 1
fi

# ── 3. Block staging of CLEO runtime state at ANY path (T14189) ─────
# cleo.db / brain.db / tasks.db (and their WAL files), project-info.json
# carrying a "projectId", and a config.json byte-identical to
# .cleo/config.json must NEVER be committed: ADR-013 §9 (T5158 data-loss
# vector), and T14189 (a cleo call inside a git hook once staged .cleo state
# files into this index as ROOT paths). `cleo doctor` runs the same rule.
LEAKED=""
CLEO_CONFIG_BLOB=""
if [ -f .cleo/config.json ]; then
  CLEO_CONFIG_BLOB=$(git hash-object .cleo/config.json 2>/dev/null || true)
fi
STAGED_RAW=$(git -c core.quotePath=false diff --cached --raw --no-abbrev --no-renames --diff-filter=d)
TAB=$(printf '\t')
while IFS= read -r line; do
  [ -n "$line" ] || continue
  meta=${line%%"$TAB"*}
  path=${line#*"$TAB"}
  blob=$(echo "$meta" | awk '{print $4}')
  case "${path##*/}" in
    cleo.db|cleo.db-wal|cleo.db-shm|cleo.db-journal|\
    brain.db|brain.db-wal|brain.db-shm|brain.db-journal|\
    tasks.db|tasks.db-wal|tasks.db-shm|tasks.db-journal)
      LEAKED="$LEAKED $path" ;;
    project-info.json)
      if git cat-file -p "$blob" 2>/dev/null | grep -q '"projectId"'; then
        LEAKED="$LEAKED $path"
      fi ;;
    config.json)
      if [ "$path" = ".cleo/config.json" ] || { [ -n "$CLEO_CONFIG_BLOB" ] && [ "$blob" = "$CLEO_CONFIG_BLOB" ]; }; then
        LEAKED="$LEAKED $path"
      fi ;;
  esac
done <<EOF_STAGED
$STAGED_RAW
EOF_STAGED

if [ -n "$LEAKED" ]; then
  echo "ERROR: Refusing to commit CLEO runtime state (ADR-013 §9, T14189):"
  for f in $LEAKED; do echo "  $f"; done
  echo ""
  echo "These are .cleo runtime files (databases, project identity, config)"
  echo "that must never be tracked; committing them re-opens the T5158"
  echo "data-loss vector."
  echo "To fix: git reset -q --$LEAKED"
  exit 1
fi

# ── 4. Refuse staged .cleo/ runtime paths (T14549) ───────────────────
# CLEO_RUNTIME_DENY is the EXPLICIT DENY block of the shipped .cleo/.gitignore
# template, rule for rule (a test keeps the two equal). It is embedded, not
# read from the checkout's .cleo/.gitignore, so a user-edited file cannot turn
# the guard off. A forced `git add -f`, or a file tracked before the rule
# existed, would otherwise be committed, and a later checkout or pull would
# replace the live store under its WAL. The identity files stay tracked.
CLEO_RUNTIME_DENY="*.db *.db-shm *.db-wal *.db-journal config.json project-info.json nexus-link.json log.json tasks-log.jsonl todo-log.jsonl bypass-log.json qa-log.json .deps-cache/ .context-alert-state.json .context-state*.json context-states/ .git-checkpoint-state .migration-state.json migrations.json sync/ metrics/ .backups/ backups/ quarantine/ session-journals/"
RUNTIME=""
STAGED_CLEO=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR -- .cleo)
set -f
while IFS= read -r path; do
  [ -n "$path" ] || continue
  rel=${path#.cleo/}
  case "$rel" in project.json|project-id) continue ;; esac
  for pat in $CLEO_RUNTIME_DENY; do
    dir=${pat%/}
    if [ "$dir" != "$pat" ]; then
      case "/$rel" in */$dir/*) RUNTIME="$RUNTIME $path"; break ;; esac
    else
      case "/$rel" in */$pat|*/$pat/*) RUNTIME="$RUNTIME $path"; break ;; esac
    fi
  done
done <<EOF_CLEO
$STAGED_CLEO
EOF_CLEO
set +f

if [ -n "$RUNTIME" ]; then
  echo "ERROR: Refusing to commit .cleo runtime files (ADR-013 §9, T14549):"
  for f in $RUNTIME; do echo "  $f"; done
  echo ""
  echo "These are .cleo runtime paths (databases, backups, logs, caches)."
  echo "Tracking them lets a checkout or pull replace the live store while its"
  echo "WAL stays behind."
  echo "To fix: git rm --cached -q --$RUNTIME"
  echo "(or run: cleo doctor --fix, which untracks every .cleo runtime file)"
  exit 1
fi

exit 0
