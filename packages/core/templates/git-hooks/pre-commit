#!/bin/sh
# CLEO_MANAGED_HOOK v1
# Pre-commit guardrails:
#   1. Reject SQLite WAL/SHM files (data corruption risk).
#   2. Block commits when core CLEO files are gitignored (data integrity).
#   3. Refuse CLEO runtime state staged at ANY path (T14189).
#   4. Refuse staged .cleo/ runtime paths: the shipped .cleo/.gitignore
#      EXPLICIT DENY rules (T14549).
#
# A pre-commit hook that was here before CLEO runs FIRST (T14549), so every
# check below sees the index that hook leaves behind.
#
# Every staged change except a deletion is checked (additions, modifications,
# renames, type changes): staging the deletion of a runtime file
# (`git rm --cached`, `cleo doctor --fix`) is the repair.
#
# Paths are matched by git itself (pathspecs, `git diff --quiet`), never by
# parsing names in the shell, so no quote, space or newline in a name can
# slip past a check.
#
# Installation: Automatically installed via `cleo init`

set -e

# ── 0. A pre-commit hook that was here before CLEO (chained, T14549) ──
if [ -x "$0.cleo-chained" ]; then
  "$0.cleo-chained" "$@" || exit $?
fi

# ── 1. WAL/SHM/journal files ──────────────────────────────────────────
WAL_SPECS=":(glob)**/*.db-wal :(glob)**/*.db-shm :(glob)**/*.db-journal"
set -f
# shellcheck disable=SC2086
if ! git diff --cached --quiet --diff-filter=d -- $WAL_SPECS; then
  echo "ERROR: Refusing to commit SQLite WAL/SHM/journal files:"
  # shellcheck disable=SC2086
  git diff --cached --name-only --diff-filter=d -- $WAL_SPECS | sed 's/^/  /'
  echo ""
  echo "These are runtime files that must never be tracked in git."
  echo "To fix: git rm --cached <file>"
  exit 1
fi
set +f

# ── 2. Core file gitignore protection ─────────────────────────────────
# Per ADR-013 §9 (T5158 — 2026-04-07): tasks.db, brain.db, config.json,
# and project-info.json are NOT tracked in git (regenerated by cleo init,
# backed up via VACUUM INTO snapshots). DO NOT include those four files
# in PROTECTED_FILES — that would re-open the T5158 data-loss vector.
PROTECTED_FILES=".cleo/.gitignore .cleo/project-context.json"
IGNORED_CORE=""

for f in $PROTECTED_FILES; do
  if [ -f "$f" ] && git check-ignore -q "$f" 2>/dev/null; then
    IGNORED_CORE="$IGNORED_CORE $f"
  fi
done

if [ -n "$IGNORED_CORE" ]; then
  echo "ERROR: Critical CLEO files are being ignored by .gitignore:"
  echo "$IGNORED_CORE"
  echo ""
  echo "These files MUST be tracked by git for CLEO data integrity."
  echo "Check .gitignore and .cleo/.gitignore for rules ignoring these files."
  echo "To fix: remove the ignore rule, then: git add <file>"
  exit 1
fi

# ── 3. Block staging of CLEO runtime state at ANY path (T14189) ─────
# cleo.db / brain.db / tasks.db (and their WAL files), project-info.json
# carrying a "projectId", and a config.json byte-identical to
# .cleo/config.json must NEVER be committed: ADR-013 §9 (T5158 data-loss
# vector), and T14189 (a cleo call inside a git hook once staged .cleo state
# files into this index as ROOT paths). `cleo doctor` runs the same rule.
LEAKED=""
CLEO_CONFIG_BLOB=""
if [ -f .cleo/config.json ]; then
  CLEO_CONFIG_BLOB=$(git hash-object .cleo/config.json 2>/dev/null || true)
fi
STAGED_RAW=$(git -c core.quotePath=false diff --cached --raw --no-abbrev --no-renames --diff-filter=d)
TAB=$(printf '\t')
while IFS= read -r line; do
  [ -n "$line" ] || continue
  meta=${line%%"$TAB"*}
  path=${line#*"$TAB"}
  blob=$(echo "$meta" | awk '{print $4}')
  # git C-quotes a name holding a quote, backslash or control character
  # (one line, escapes inside). Such a name is judged by its last component
  # and refused without a content check: fail closed (T14549).
  quoted=""
  name=${path##*/}
  case "$path" in
    \"*\") quoted=1; name=${path%\"}; name=${name##*/} ;;
  esac
  case "$name" in
    cleo.db|cleo.db-wal|cleo.db-shm|cleo.db-journal|\
    brain.db|brain.db-wal|brain.db-shm|brain.db-journal|\
    tasks.db|tasks.db-wal|tasks.db-shm|tasks.db-journal)
      LEAKED="$LEAKED $path" ;;
    project-info.json)
      if [ -n "$quoted" ] || git cat-file -p "$blob" 2>/dev/null | grep -q '"projectId"'; then
        LEAKED="$LEAKED $path"
      fi ;;
    config.json)
      if [ -n "$quoted" ] || [ "$path" = ".cleo/config.json" ] || { [ -n "$CLEO_CONFIG_BLOB" ] && [ "$blob" = "$CLEO_CONFIG_BLOB" ]; }; then
        LEAKED="$LEAKED $path"
      fi ;;
  esac
done <<EOF_STAGED
$STAGED_RAW
EOF_STAGED

if [ -n "$LEAKED" ]; then
  echo "ERROR: Refusing to commit CLEO runtime state (ADR-013 §9, T14189):"
  for f in $LEAKED; do echo "  $f"; done
  echo ""
  echo "These are .cleo runtime files (databases, project identity, config)"
  echo "that must never be tracked; committing them re-opens the T5158"
  echo "data-loss vector."
  echo "To fix: git reset -q --$LEAKED"
  exit 1
fi

# ── 4. Refuse staged .cleo/ runtime paths (T14549) ───────────────────
# CLEO_RUNTIME_PATHSPECS are git pathspecs for the EXPLICIT DENY block of the
# shipped .cleo/.gitignore template (`runtimePathspecs()` in core; a test keeps
# the two equal). They are embedded, not read from the checkout's
# .cleo/.gitignore, so a user-edited file cannot turn the guard off. Git
# matches them against the index, so names are never parsed here. A forced
# `git add -f`, or a file tracked before the rule existed, would otherwise be
# committed, and a later checkout or pull would replace the live store under
# its WAL. The identity files stay tracked.
CLEO_RUNTIME_PATHSPECS=":(glob).cleo/**/*.db :(glob).cleo/**/*.db/** :(glob).cleo/**/*.db-shm :(glob).cleo/**/*.db-shm/** :(glob).cleo/**/*.db-wal :(glob).cleo/**/*.db-wal/** :(glob).cleo/**/*.db-journal :(glob).cleo/**/*.db-journal/** :(glob).cleo/**/config.json :(glob).cleo/**/config.json/** :(glob).cleo/**/project-info.json :(glob).cleo/**/project-info.json/** :(glob).cleo/**/nexus-link.json :(glob).cleo/**/nexus-link.json/** :(glob).cleo/**/log.json :(glob).cleo/**/log.json/** :(glob).cleo/**/tasks-log.jsonl :(glob).cleo/**/tasks-log.jsonl/** :(glob).cleo/**/todo-log.jsonl :(glob).cleo/**/todo-log.jsonl/** :(glob).cleo/**/bypass-log.json :(glob).cleo/**/bypass-log.json/** :(glob).cleo/**/qa-log.json :(glob).cleo/**/qa-log.json/** :(glob).cleo/**/.deps-cache/** :(glob).cleo/**/.context-alert-state.json :(glob).cleo/**/.context-alert-state.json/** :(glob).cleo/**/.context-state*.json :(glob).cleo/**/.context-state*.json/** :(glob).cleo/**/context-states/** :(glob).cleo/**/.git-checkpoint-state :(glob).cleo/**/.git-checkpoint-state/** :(glob).cleo/**/.migration-state.json :(glob).cleo/**/.migration-state.json/** :(glob).cleo/**/migrations.json :(glob).cleo/**/migrations.json/** :(glob).cleo/**/sync/** :(glob).cleo/**/metrics/** :(glob).cleo/**/.backups/** :(glob).cleo/**/backups/** :(glob).cleo/**/quarantine/** :(glob).cleo/**/session-journals/** :(exclude,literal).cleo/project.json :(exclude,literal).cleo/project-id"
set -f
# shellcheck disable=SC2086
if ! git diff --cached --quiet --diff-filter=d -- $CLEO_RUNTIME_PATHSPECS; then
  QUOTED_SPECS=""
  for spec in $CLEO_RUNTIME_PATHSPECS; do QUOTED_SPECS="$QUOTED_SPECS '$spec'"; done
  echo "ERROR: Refusing to commit .cleo runtime files (ADR-013 §9, T14549):"
  # shellcheck disable=SC2086
  git diff --cached --name-only --diff-filter=d -- $CLEO_RUNTIME_PATHSPECS | sed 's/^/  /'
  echo ""
  echo "These are .cleo runtime paths (databases, backups, logs, caches)."
  echo "Tracking them lets a checkout or pull replace the live store while its"
  echo "WAL stays behind."
  echo "To fix: git diff --cached -z --name-only --diff-filter=d --$QUOTED_SPECS | xargs -0 git rm --cached -q --"
  echo "(or run: cleo doctor --fix, which untracks every .cleo runtime file)"
  exit 1
fi
set +f

exit 0
